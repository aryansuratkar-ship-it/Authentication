<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        body {
            background: #f5f7fb;
            min-height: 100vh;
        }

        .profile-card {
            max-width: 500px;
            border: none;
            border-radius: 20px;
            overflow: hidden;
        }

        .profile-header {
            height: 130px;
            background: linear-gradient(135deg, #0d6efd, #6610f2);
        }

        .profile-img {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            border: 5px solid white;
            object-fit: cover;
            margin-top: -55px;
            background: white;
        }

        .info-box {
            background: #f8f9fa;
            border-radius: 12px;
        }
    </style>
</head>

<body>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card profile-card shadow-lg w-100">

            <!-- Header -->
            <div class="profile-header"></div>

            <!-- Profile -->
            <div class="card-body text-center">

                <img
                    src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIU332qeslYv5TUe6aU6X_pg5sUe1kLd426yO6GxDplg&s=10"
                    alt="Profile"
                    class="profile-img"
                >

                <h2 class="fw-bold mt-3 mb-1">Hi, <%= result.name %> 👋</h2>

                <p class="text-muted mb-4">
                    Welcome back to your profile
                </p>

                <!-- User Information -->
                <div class="info-box p-3 mb-3 text-start">

                    <div class="mb-3">
                        <small class="text-muted">Name</small>
                        <h6 class="mb-0"><%= result.name %></h6>
                    </div>

                    <div>
                        <small class="text-muted">Email</small>
                        <h6 class="mb-0"><%= result.email %></h6>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg">
                        Edit Profile
                    </button>

                    <button class="btn btn-outline-danger" onclick="window.location.href='/login'">
                        Logout
                    </button>
                </div>

            </div>
        </div>

    </div>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>

